---
/** The home page. With JavaScript, the desktop will boot on top of this (Phase 2). */
import { render } from 'astro:content';
import Document from '../layouts/Document.astro';
import MemoList from '../components/MemoList.astro';
import { DIVISIONS } from '../os/divisions';
import { url } from '../os/routes';
import { getMemos, getPage, getProjects } from '../site/content';

const page = await getPage('home');
const { Content } = await render(page);
const projects = await getProjects();
const memos = (await getMemos()).slice(0, 3);
const count = (id: string) => projects.filter((p) => p.data.division === id).length;
---

<Document title="HSOS" path="/" section="home" description={page.data.summary}>
  <div class="prose">
    <Content />
  </div>

  <section class="doc-section" aria-labelledby="home-divisions">
    <h2 id="home-divisions">Divisions</h2>
    <ul class="division-index">
      {
        DIVISIONS.map((d) => (
          <li>
            <a href={url.division(d.id)}>{d.name}</a>
            <span>{count(d.id) === 1 ? '1 asset' : `${count(d.id)} assets`}</span>
          </li>
        ))
      }
    </ul>
    <p><a href={url.divisions}>Every asset, filed by division</a></p>
  </section>

  <section class="doc-section" aria-labelledby="home-memos">
    <h2 id="home-memos">Latest memos</h2>
    <MemoList memos={memos} />
  </section>
</Document>
