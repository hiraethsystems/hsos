---
/**
 * The static page layout, in HSOS document style. Every content page uses this, and every page
 * must read properly with JavaScript turned off (CLAUDE.md rule 1).
 */
import { cssVariables, type TitleRampName } from '../os/palette';
import { divisionName } from '../os/divisions';
import { pathSegments, STATIC_DIRS, url } from '../os/routes';
import Shell from '../os/Shell';
import { getMemos, getProjects } from '../site/content';
import '../styles/global.css';
import '../styles/shell.css';
import '../styles/themes.css';

type Section = 'home' | 'welcome' | 'divisions' | 'memos';

interface Props {
  /** Page title for the browser tab and search results. */
  title: string;
  /** Filesystem path shown in the title bar, for example /srv/divisions/ */
  path: string;
  /** Title bar colour ramp, as for apps. */
  ramp?: TitleRampName;
  description?: string;
  /** Which top bar link to mark as current. */
  section?: Section;
}

const {
  title,
  path,
  ramp = 'docs',
  description = 'HSOS, the operating system of Hiraeth Systems. All feelings reserved.',
  section,
} = Astro.props;

const fullTitle = title === 'HSOS' ? title : `${title} · HSOS`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const windowColours = `--win-bands: var(--bands-${ramp}); --win-dark: var(--ramp-${ramp}-0); --win-shadow: var(--c-shadow-${ramp});`;

const projects = await getProjects();
const linkable = new Set([...STATIC_DIRS, ...projects.map((p) => url.dossier(p.data.division, p.id))]);
const shellProjects = projects.map((p) => ({
  name: p.data.name,
  slug: p.id,
  division: p.data.division,
  url: url.dossier(p.data.division, p.id),
  divisionName: divisionName(p.data.division),
}));
const shellMemos = (await getMemos()).map((m) => ({ slug: m.id, title: m.data.title, url: url.memo(m.id) }));
const segments = pathSegments(path, linkable, Astro.url.pathname);

const nav: { section: Section; href: string; label: string }[] = [
  { section: 'welcome', href: url.welcome, label: 'Handbook' },
  { section: 'divisions', href: url.divisions, label: 'Divisions' },
  { section: 'memos', href: url.memos, label: 'Memos' },
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/vt323-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={cssVariables()} />
    <script is:inline>
      // If the desktop (or HSOS Handheld) is going to start, hide the static page now rather
      // than flash it. The shell confirms it is running; if it has not within 4 seconds, show
      // the page. Visitors who chose Plain View keep the page.
      (function () {
        var root = document.documentElement;
        try {
          if (window.sessionStorage.getItem('hsos.plain') !== '1') {
            root.classList.add('hsos-shell');
            // Load the visitor's theme now too, so the desktop does not flash the house colours.
            var theme = (JSON.parse(window.localStorage.getItem('hsos.settings.v1') || '{}') || {}).theme;
            if (typeof theme === 'string' && /^[a-z0-9]+$/.test(theme) && theme !== 'hsos') root.dataset.theme = theme;
            window.setTimeout(function () {
              if (!root.classList.contains('hsos-shell-ready')) {
                root.classList.remove('hsos-shell');
                delete root.dataset.theme;
              }
            }, 4000);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="doc">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="doc-bar">
      <a class="doc-brand" href={url.home} aria-current={section === 'home' ? 'page' : undefined}>◆ HIRAETH SYSTEMS</a>
      <nav aria-label="Main">
        <ul>
          {
            nav.map((n) => (
              <li>
                <a href={n.href} aria-current={section === n.section ? 'page' : undefined}>
                  {n.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main id="main" class="doc-window" style={windowColours}>
      <h1 class="doc-title">
        <span class="visually-hidden">{title}, at </span>
        {segments.map((s) => (s.href ? <a href={s.href}>{s.label}</a> : <span>{s.label}</span>))}
      </h1>
      <div class="doc-body">
        <slot />
      </div>
    </main>
    <footer class="doc-footer">HSOS 256. All feelings reserved.</footer>
    <div id="hsos-root"><Shell client:only="preact" projects={shellProjects} memos={shellMemos} /></div>
  </body>
</html>
